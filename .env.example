# Sanitized template. Copy to .env and set your own values.
SSH_EXE=%WINDIR%\System32\OpenSSH\ssh.exe
SSH_KEY=%USERPROFILE%\.ssh\YOUR_PRIVATE_KEY
HEIDI_EXE=C:\Path\To\HeidiSQL\heidisql.exe

SSH_HOST=your-vps.example.com
SSH_USER=your-ssh-user
SSH_PORT=22

LOCAL_HOST=127.0.0.1
LOCAL_PORT=3307
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=3306

HEIDI_SESSION=YOUR_SAVED_SESSION
HEIDI_PROCESS_NAME=heidisql
HEIDI_SESSION_ARGUMENT_PREFIX=-d=

CHECK_EXISTING_HEIDISQL=true
TUNNEL_START_TIMEOUT_SECONDS=15
TCP_CONNECT_TIMEOUT_MS=500
POLL_INTERVAL_MS=250

SSH_KEEPALIVE_INTERVAL_SECONDS=30
SSH_KEEPALIVE_COUNT_MAX=3
SSH_EXIT_ON_FORWARD_FAILURE=yes
SSH_BATCH_MODE=false
SSH_STRICT_HOST_KEY_CHECKING=accept-new
SSH_SERVER_ALIVE_ENABLED=true
SSH_PROCESS_NAME=ssh

STOP_SSH_ON_EXIT=true
SHOW_MESSAGES=true
